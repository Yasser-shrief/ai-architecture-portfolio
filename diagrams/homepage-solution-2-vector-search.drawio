ml=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="755" y="460" width="210" height="40" as="geometry"/></mxCell><mxCell id="m6" value="7. Search nearest product vectors" style="html=1;endArrow=block;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="540" as="sourcePoint"/><mxPoint x="1350" y="540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m7" value="8. Candidate product IDs and scores" style="html=1;endArrow=block;dashed=1;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1350" y="600" as="sourcePoint"/><mxPoint x="860" y="600" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m8" value="Rank candidates; select Top-K" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="755" y="640" width="210" height="40" as="geometry"/></mxCell><mxCell id="m9" value="If missing, empty or timeout: popular products" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="755" y="700" width="210" height="40" as="geometry"/></mxCell><mxCell id="m10" value="11. Ranked product IDs" style="html=1;endArrow=block;dashed=1;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="780" as="sourcePoint"/><mxPoint x="615" y="780" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m11" value="12. Fetch products in one query" style="html=1;endArrow=block;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615" y="840" as="sourcePoint"/><mxPoint x="1595" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m12" value="13. Details, prices and availability" style="html=1;endArrow=block;dashed=1;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1595" y="900" as="sourcePoint"/><mxPoint x="615" y="900" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m13" value="Filter unavailable items; keep order" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="940" width="210" height="40" as="geometry"/></mxCell><mxCell id="m14" value="15. Recommended products" style="html=1;endArrow=block;dashed=1;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615" y="1020" as="sourcePoint"/><mxPoint x="370" y="1020" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m15" value="16. Return recommendations" style="html=1;endArrow=block;dashed=1;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="1080" as="sourcePoint"/><mxPoint x="125" y="1080" as="targetPoint"/></mxGeometry></mxCell><mxCell id="notes" value="Returning user opens homepage. Normal path: build customer query embedding and search at request time. If features are missing, skip embedding/search and use preloaded popular products. Assumptions: compatible model is loaded inside Recommendation Engine; product vectors and customer features are prepared in background." style="html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="1255" width="1660" height="75" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
